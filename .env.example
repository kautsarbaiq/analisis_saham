# Salin file ini ke `.env` lalu isi nilainya. JANGAN commit `.env`.
# Semua layanan di bawah punya free-tier yang cukup untuk MVP pribadi.

# --- SEC EDGAR (fundamental US) ---
# Tidak perlu API key, TAPI wajib set User-Agent berisi email (aturan SEC).
SEC_USER_AGENT="Project Bandar pragozjawir@gmail.com"

# --- FRED (data makro The Fed) — gratis, daftar di fred.stlouisfed.org ---
FRED_API_KEY=""

# --- Berita ---
NEWSAPI_KEY=""          # newsapi.org (free-tier 100 req/hari)
# GDELT tidak butuh key.

# --- LLM untuk klasifikasi event & laporan riset (free-tier) ---
GROQ_API_KEY=""         # console.groq.com (Llama gratis, cepat)
GEMINI_API_KEY=""       # ai.google.dev (Gemini free-tier)

# --- Alert ---
TELEGRAM_BOT_TOKEN=""   # dari @BotFather
TELEGRAM_CHAT_ID=""     # chat id tujuan alert

# --- Database (opsional; default DuckDB lokal tanpa kredensial) ---
SUPABASE_URL=""
SUPABASE_KEY=""

# --- Path lokal ---
DUCKDB_PATH="data/bandar.duckdb"
